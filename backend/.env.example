PORT=3000
FRONTEND_URL=http://localhost:5173
# Lokal: Docker Postgres (tanpa TLS). Supabase: Session pooler (port 5432), TLS diverifikasi dengan certs/prod-ca-2021.crt.
# Password dengan karakter khusus (@ : / # ? %) wajib di-URL-encode. Jangan tambahkan ?sslmode=.
DATABASE_URL=postgresql://djajan:djajan@localhost:5433/djajan
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PUBLIC_SITE_URL=http://localhost:5173
GITHUB_DISPATCH_TOKEN=
# Seed admin (npm run seed:admin). Password minimal 12 karakter.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password role database, dipakai npm run migrate (002_roles.sql). Kosong = role dibuat tanpa password.
APP_BACKEND_DB_PASSWORD=
FORECAST_JOB_DB_PASSWORD=
